{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["node"],
        "paths": {
            "@deltabox/toolchain": ["../toolchain/src/index.ts"],
            "@deltabox/toolchain/globals": ["../toolchain/src/globals.ts"],
            "@deltabox/toolchain/providers": ["../toolchain/src/providers.ts"],
            "@deltabox/toolchain/cli": ["../toolchain/src/cli/index.ts"],
            "@deltabox/toolchain/vite": ["../toolchain/src/vite.ts"],
            "@deltabox/toolchain/biome": ["../toolchain/packages/biome/src/index.ts"],
            "@deltabox/toolchain/changelog": ["../toolchain/packages/changelog/src/index.ts"],
            "@deltabox/toolchain/changelog/*": ["../toolchain/packages/changelog/src/*"],
            "@deltabox/toolchain/config": ["../toolchain/packages/config/src/index.ts"],
            "@deltabox/toolchain/config/*": ["../toolchain/packages/config/src/*"],
            "@deltabox/toolchain/core": ["../toolchain/packages/core/src/index.ts"],
            "@deltabox/toolchain/core/*": ["../toolchain/packages/core/src/*"],
            "@deltabox/toolchain/docker": ["../toolchain/packages/docker/src/index.ts"],
            "@deltabox/toolchain/docker/*": ["../toolchain/packages/docker/src/*"],
            "@deltabox/toolchain/mcp": ["../toolchain/packages/mcp/src/index.ts"],
            "@deltabox/toolchain/mcp/*": ["../toolchain/packages/mcp/src/*"],
            "@deltabox/toolchain/migrate": ["../toolchain/packages/migrate/src/index.ts"],
            "@deltabox/toolchain/migrate/*": ["../toolchain/packages/migrate/src/*"],
            "@deltabox/toolchain/pack": ["../toolchain/packages/pack/src/index.ts"],
            "@deltabox/toolchain/pack/*": ["../toolchain/packages/pack/src/*"],
            "@deltabox/toolchain/project": ["../toolchain/packages/project/src/index.ts"],
            "@deltabox/toolchain/project/*": ["../toolchain/packages/project/src/*"],
            "@deltabox/toolchain/shared": ["../toolchain/packages/shared/src/index.ts"],
            "@deltabox/toolchain/shared/*": ["../toolchain/packages/shared/src/*"],
            "@deltabox/toolchain/template": ["../toolchain/packages/template/src/index.ts"],
            "@deltabox/toolchain/template/*": ["../toolchain/packages/template/src/*"],
            "@deltabox/toolchain/tsconfig": ["../toolchain/packages/tsconfig/src/index.ts"],
            "@deltabox/toolchain/tsconfig/cli": ["../toolchain/packages/tsconfig/src/cli/index.ts"],
            "@deltabox/toolchain/tsconfig/*": ["../toolchain/packages/tsconfig/src/*"],
            "@deltabox/toolchain/*": ["../toolchain/src/*"]
        }
    },
    "include": ["tests", "vite.config.ts"]
}
